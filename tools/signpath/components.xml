<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="product-version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="app/WinDesk.exe" product-name="WinDesk" product-version="${product-version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="installer/WinDesk.Uninstaller.exe" product-name="WinDesk" product-version="${product-version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
