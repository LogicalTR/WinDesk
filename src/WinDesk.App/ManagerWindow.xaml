<Window x:Class="WinDesk.App.ManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDesk — Masaüstü panellerin" Width="1020" Height="720" MinWidth="840" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#111722" Foreground="#EDF1F7" FontFamily="Segoe UI">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#171F2C" BorderBrush="#293243" BorderThickness="0,0,1,0">
      <Grid Margin="22,30,22,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <Border Background="#73D9C3" Width="40" Height="40" CornerRadius="11" HorizontalAlignment="Left"><TextBlock Text="W" Foreground="#10231F" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="WinDesk" FontSize="25" FontWeight="SemiBold" Margin="0,14,0,4"/>
          <TextBlock Text="Sana ait bir masaüstü." Foreground="{StaticResource MutedInk}" FontSize="12"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#253C3D" CornerRadius="8" Padding="14,12" Margin="0,38,0,0"><TextBlock Text="▦   Paneller" Foreground="#93E7D5" FontSize="14"/></Border>
        <StackPanel Grid.Row="3">
          <TextBlock Text="AZ GÖRÜNTÜ, DAHA ÇOK ALAN" FontSize="10" Foreground="#A4AFC1"/>
          <TextBlock Text="Başlığın üzerine gel.&#10;İhtiyacın olanı aç." FontSize="13" Margin="0,10,0,24" LineHeight="21"/>
          <TextBlock Text="WinDesk 0.7.2 · Masaüstü" FontSize="11" Foreground="#A4AFC1"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,28,32,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="Yer aç. Odaklan." FontSize="30" FontWeight="SemiBold"/>
        <TextBlock Text="Uygulamaların elinin altında, masaüstün ferah kalsın." Foreground="{StaticResource MutedInk}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <DockPanel Grid.Row="1" Margin="0,30,0,16">
        <Button DockPanel.Dock="Right" Content="+  Yeni panel" Style="{StaticResource AccentButton}" Click="NewPanel_Click"/>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="Masaüstü panellerin" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="Summary" Foreground="{StaticResource MutedInk}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
      </DockPanel>
      <DockPanel Grid.Row="2">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
          <Button x:Name="MergeButton" Content="Seçilenleri birleştir" IsEnabled="False" Click="Merge_Click" Padding="12,7"/>
          <TextBlock x:Name="SelectionHint" Text="Birleştirmek için en az iki grup seçin." Foreground="{StaticResource MutedInk}" FontSize="12" VerticalAlignment="Center" Margin="12,6,0,6"/>
        </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="PanelCards"/>
        </ScrollViewer>
      </DockPanel>
      <Border Grid.Row="3" Background="#1B2230" BorderBrush="#303A4B" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,18,0,16">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,16,0"><TextBlock Text="Kapanmadan önce bekle" FontSize="14"/><TextBlock Text="Fare panelden ayrıldığında uygulanır." Foreground="{StaticResource MutedInk}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock x:Name="DelayLabel" HorizontalAlignment="Right" FontSize="12" Foreground="#73D9C3" Margin="0,0,0,8"/><Slider x:Name="CloseDelay" Minimum="200" Maximum="1500" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="CloseDelay_Changed" AutomationProperties.Name="Panel kapanma gecikmesi"/></StackPanel>
        </Grid>
      </Border>
      <DockPanel Grid.Row="4">
        <Button DockPanel.Dock="Right" x:Name="VisibilityButton" Content="Panelleri gizle" Click="Visibility_Click" Padding="12,7"/>
        <TextBlock x:Name="DesktopStatusText" Foreground="{StaticResource MutedInk}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0"/>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
