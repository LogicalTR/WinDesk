<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- This is a WPF process. WinForms is only used for NotifyIcon/Screen;
         WPF DPI awareness belongs in the application manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WinDesk.ico</ApplicationIcon>
    <AssemblyName>WinDesk</AssemblyName>
    <RootNamespace>WinDesk.App</RootNamespace>
    <Version>0.7.11</Version>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../WinDesk.Core/WinDesk.Core.csproj" /></ItemGroup>
</Project>
